# on first start. The first execution starts the program, and the second opens
# the GUI (while also killing the first)
#
# Note that we also export certain XDG environment variables to GNOME so that
# we can get UI icons to show up correctly
#for_window [class="Keyboard Center"] move scratchpad
#exec --no-startup-id "XDG_SESSION_DESKTOP=GNOME XDG_CURRENT_DESKTOP=GNOME /usr/bin/keyboard-center --background-mode"
#exec --no-startup-id "sleep 5; XDG_SESSION_DESKTOP=GNOME XDG_CURRENT_DESKTOP=GNOME /usr/bin/keyboard-center"

# Execute feh to set background
exec ~/.fehbg --no-startup-id

# Start picom (forked version with animation support)
#exec_always --no-startup-id picom -b --config ~/.config/picom/picom.conf --experimental-backends

# Execute polybar
exec_always --no-startup-id ~/.config/polybar/hack/launch.sh

# Start GNOME policy kit authentication agent, so that GNOME apps can ask for a password if needed
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

