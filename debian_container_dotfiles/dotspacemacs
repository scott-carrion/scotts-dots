  (defun my-save-window-point-constantly ()
    "Silently record the point of the current buffer into the window's memory."
    (when-let* ((win (selected-window))
                ((window-live-p win)))
      (let* ((hash (or (window-parameter win 'my-buffer-points)
                       (let ((h (make-hash-table :test 'equal)))
                         (set-window-parameter win 'my-buffer-points h)
                         h)))
             (buf-name (buffer-name (window-buffer win)))
             (curr-point (window-point win)))
        ;; Only update the hash table if the point actually changed
        (unless (equal (gethash buf-name hash) curr-point)
          (puthash buf-name curr-point hash)))))

  ;; Track the point after every command (a very lightweight operation)
  (add-hook 'post-command-hook #'my-save-window-point-constantly)


  ;; Helper function to dynamically list existing saved perspectives
  (defun my-get-saved-perspectives ()
    "Return a list of saved perspective directories from the cache."
    (let ((persp-dir (expand-file-name "~/.emacs.d/.cache/persp/")))
      (if (file-directory-p persp-dir)
          (seq-filter (lambda (f)
                        (file-directory-p (expand-file-name f persp-dir)))
                      (directory-files persp-dir nil "^[^.]")) ; Exclude hidden/. /..
        '())))

  (defvar scc-display-workspace-header-line t
    "When non-nil, display the eyebrowse workspace header line on the active window.")

  (defun scc-toggle-display-workspace-header-line ()
    "Toggle workspace header line on active window."
    (interactive)
    (setq scc-display-workspace-header-line (not scc-display-workspace-header-line)))

  (defun my-spacemacs-header-workspace-tabs ()
    "Generate a string of eyebrowse workspaces formatted as a visual tab bar.
  Does nothing if the current buffer has its own header line configured."
    ;;  Ensure this buffer hasn't defined its own local header line
    (unless (local-variable-p 'header-line-format)
      (when (and scc-display-workspace-header-line
                 (bound-and-true-p eyebrowse-mode)
                 (eq (selected-window) (frame-selected-window)))
        (let* ((current-slot (eyebrowse--get 'current-slot))
               (window-configs (eyebrowse--get 'window-configs))
               (tabs '())

               ;; --- NEW LAYOUT EXTRACTION ---
               ;; Get layout name (fallback to "Default" if persp-mode is inactive)
               (layout-name (if (and (bound-and-true-p persp-mode)
                                     (fboundp 'get-current-persp)
                                     (get-current-persp))
                                (persp-name (get-current-persp))
                              "Default"))

               ;; Find layout numerical index (1-based to match Spacemacs keys like SPC l 1)
               (layout-number (if (and (bound-and-true-p persp-mode)
                                       (fboundp 'persp-names))
                                  (let ((idx (cl-position layout-name (persp-names) :test #'string=)))
                                    (if idx (1+ idx) 1))
                                1))

               ;; Format the layout text to display before [WS]
               (layout-text (format "  %d  %s  " layout-number layout-name)))

          (dolist (window-config window-configs)
            (let* ((slot (car window-config))
                   (tag (nth 2 window-config))
                   (tab-text (if (and tag (> (length tag) 0))
                                 (format "  %d  %s  " slot tag)
                               (format "  %d  " slot)))
                   (is-current (= slot current-slot))
                   (face (if is-current 'mode-line-highlight 'mode-line-inactive)))

              (push (propertize tab-text 'face face) tabs)))

          (concat (propertize " [L] " 'face 'mode-line-emphasis)
                  (propertize layout-text 'face 'mode-line-highlight)
                  (propertize " [WS] " 'face 'mode-line-emphasis)
                  (mapconcat 'identity (nreverse tabs) (propertize " " 'face 'mode-line-inactive)))))))

  (setq-default header-line-format '((:eval (my-spacemacs-header-workspace-tabs))))

  (defun my-spacemacs-hide-inactive-header-lines (&rest _)
    "Completely disable the header line on windows that do not have focus.
  If `scc-display-workspace-header-line' is nil, forcefully hide it on all windows.
  Skips any window that has a custom buffer-local header line."
    (walk-windows
     (lambda (w)
       ;; Check if the buffer inside the target window has a local header line
