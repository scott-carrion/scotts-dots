  (defun scc-format-project-name (input-string)
    "Format INPUT-STRING to show only the base folder if it's a project path.
If INPUT-STRING is \"Project: /path/to/folder\", return \"Project: folder\".
Otherwise, return INPUT-STRING unaltered."
    ;; Protect global match data, which is best practice when using regex in Elisp
    (save-match-data
      (if (string-match "^Project: \\(.*\\)$" input-string)
          (let* ((path (match-string 1 input-string))
                 ;; directory-file-name strips trailing slashes if they exist
                 ;; file-name-nondirectory grabs just the final folder name
                 (folder (file-name-nondirectory (directory-file-name path))))
            (format "[P] %s" folder))
        ;; If the regex doesn't match, return the original string
        input-string)))

