  ;; ---------------------------------------------------------------------------
  ;; GDB hook that replaces the program input/output buffer with vterm
  ;; ---------------------------------------------------------------------------
  (defvar scc-use-vterm-for-gdb t
    "If non-nil, automatically swap GDB's default I/O buffer for a vterm buffer.")

  (defun scc-toggle-gdb-vterm ()
    "Toggle the use of vterm for GDB I/O buffers."
    (interactive)
    (setq scc-use-vterm-for-gdb (not scc-use-vterm-for-gdb))
    (message "GDB vterm swap is now %s" (if scc-use-vterm-for-gdb "ENABLED" "DISABLED")))

  (defun scc-gdb-vterm-setup ()
    "Replaces the default GDB I/O buffer with a vterm buffer and routes TTY."
    ;; Check the global variable before proceeding
    (if scc-use-vterm-for-gdb
        (progn
          (require 'vterm)

          (let* ((io-buffer-name (gdb-inferior-io-name))
                 ;; Find the window currently displaying the default I/O buffer
                 (io-window (get-buffer-window io-buffer-name))
                 ;; Create a unique name for the vterm buffer based on the GDB session
                 (vterm-buffer-name (format "*vterm-gdb-io-%s*" (buffer-name)))
                 (vterm-buffer (get-buffer-create vterm-buffer-name)))

            ;; Initialize vterm quietly in the background
            (save-window-excursion
              (with-current-buffer vterm-buffer
                (unless (derived-mode-p 'vterm-mode)
                  (vterm-mode))))

            ;; Retrieve the PTY (pseudo-terminal) allocated to vterm
            (let ((tty (process-tty-name (get-buffer-process vterm-buffer))))
              (when tty
                ;; Instruct GDB to route the debugged program's I/O to this PTY
                (gud-basic-call (format "-gdb-set inferior-tty %s" tty))))

            ;; Hot-swap the default I/O window to display our new vterm buffer
            (when io-window
              ;; Remove the dedication lock from the window
              (set-window-dedicated-p io-window nil)

              ;; Swap the buffer to vterm
              (set-window-buffer io-window vterm-buffer)

              ;; Re-lock the window to the new vterm buffer
              (set-window-dedicated-p io-window t)

              ;; Silently kill the default I/O buffer
              (let ((io-buf (get-buffer io-buffer-name)))
                (when io-buf
                  (let ((proc (get-buffer-process io-buf)))
                    (when proc
                      ;; Disable the "Buffer has a running process; kill it?" prompt
                      (set-process-query-on-exit-flag proc nil)))
                  (kill-buffer io-buf))))))))

