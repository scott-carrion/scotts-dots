         (if (and scc-display-workspace-header-line
                  (eq w (selected-window)))
             ;; If the toggle is ON and this is the active window, show it
             (set-window-parameter w 'header-line-format nil)
           ;; If the toggle is OFF, or if this is an inactive window, kill it
           (set-window-parameter w 'header-line-format 'none))))
     nil t))

